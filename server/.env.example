# Copy to .env on the VPS (git-ignored, never commit real secrets).

PORT=4242

# Public origin of the landing page — used to build the Checkout return_url.
DOMAIN=http://localhost:3000

# Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=sk_live_or_test_xxx

# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP credentials (Gmail: use an "App password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_app_password
SMTP_FROM="Peptinova System <you@example.com>"

# Where the "access your system" link in the email should point to
PRODUCT_ACCESS_URL=https://www.peptinova.store/members
