# Copy this file to .env or .env.local (both are git-ignored) and fill in real values.

# Stripe publishable key (browser-safe). Vite exposes VITE_-prefixed vars to the
# client bundle — the embedded checkout form in src/Checkout.tsx reads this one.
# Stripe Dashboard -> Developers -> API keys.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# CTA checkout destination.
#   - Unset (default, used in production): buttons go to https://pepsys.impultienda.ar/
#   - "/checkout": use the built-in embedded Stripe payment form (local testing)
#   - any URL: a hosted Stripe Payment Link, etc.
# VITE_CHECKOUT_URL=/checkout
